{
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017",
    "DatabaseName": "trade-gateway"
  },
  "AWS_EMF_ENABLED": false,
  "AWS_EMF_ENVIRONMENT": "Local",
  "TracesNt": {
    "BaseUrl": "https://webgate.acceptance.ec.europa.eu:443/tracesnt/ws"
  },
  "Authentication": {
    "Cognito": {
      "Authority": "http://localhost:5000/local/cognito"
    },
    "Sts": {
      "Authority": "http://localhost:5000/local/sts"
    }
  },
  "Authorization": {
    "Principals": {
      "intra-reader": "test-intra-reader",
      "ched-reader": "test-ched-reader",
      "intra-instance-reader": "test-intra-instance-reader",
      "ched-instance-reader": "test-ched-instance-reader",
      "reference-data-reader": "test-reference-data-reader",
      "customs-quantity-reader": "test-customs-quantity-reader",
      "customs-quantity-manager": "test-customs-quantity-manager",
      "publisher": "trade-gateway-publisher"
    },
    "Permissions": {
      "ched-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/cheds/**"
        }
      ],
      "ched-instance-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/cheds/*"
        }
      ],
      "intra-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/intras/**"
        }
      ],
      "intra-instance-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/intras/*"
        }
      ],
      "reference-data-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/reference-data/**"
        }
      ],
      "customs-quantity-reader": [
        {
          "Actions": [ "READ" ],
          "Resource": "/customs/**"
        }
      ],
      "customs-quantity-manager": [
        {
          "Actions": [ "READ", "WRITE" ],
          "Resource": "/customs/**"
        }
      ],
      "publisher": [
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/intras/**"
        },
        {
          "Actions": [ "READ" ],
          "Resource": "/certificates/cheds/**"
        }
      ]
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
