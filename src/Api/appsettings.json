{
  "Mongo": {
    "DatabaseUri": "mongodb://set-automatically-when-deployed/admin?authSource=$external&authMechanism=MONGODB-AWS",
    "DatabaseName": "trade-gateway"
  },
  "AWS_EMF_ENABLED": true,
  "ChedAttachments": {
    "TopicArn": "",
    "QueueUrl": "",
    "S3Bucket": "",
    "S3Path": "ched-attachments",
    "RecordTimeToLive": "30.00:00:00",
    "RetryAfter": "00:15:00",
    "VisibilityTimeoutSeconds": 120,
    "AllowedFileTypes": [
      { "MimeType": "application/pdf", "Extensions": [ ".pdf" ] },
      { "MimeType": "image/jpeg", "Extensions": [ ".jpg", ".jpeg" ] },
      { "MimeType": "image/png", "Extensions": [ ".png" ] },
      { "MimeType": "application/msword", "Extensions": [ ".doc" ], "DetectedTypes": [ "application/x-cfb" ] },
      { "MimeType": "application/vnd.ms-excel", "Extensions": [ ".xls" ], "DetectedTypes": [ "application/x-cfb" ] }
    ]
  },
  "CdpUploader": {
    "BaseUrl": "",
    "CallbackUrl": ""
  },
  "AWS_EMF_NAMESPACE": "DEFRA/TRADE_IMPORTS/TRACES_GATEWAY",
  "TracesNt": {
    "BaseUrl": "",
    "CustomsOfficeReferenceNumber": "",
    "Credentials": {
      "Default": {
        "Username": "",
        "AuthenticationKey": "",
        "WebServiceClientId": ""
      },
      "Customs": {
        "Username": "",
        "AuthenticationKey": "",
        "WebServiceClientId": ""
      }
    }
  },
  "Authentication": {
    "Cognito": {
      "Authority": "",
      "Scope": "trade-gateway-resource-srv/access"
    },
    "Sts": {
      "Authority": "",
      "Audience": "trade-gateway"
    }
  },
  "Authorization": {
    "Principals": {
    },
    "Permissions": {
    }
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  },
  "ApiMetrics": {
    "MeterName": "Defra.TradeGateway.Api",
    "IgnoredPathPrefixes": [ "/apple-", "/favicon", "/redoc", "/.well-known/openapi" ]
  }
}
