ASPNETCORE_ENVIRONMENT=Development
AUTHENTICATION__COGNITO__AUTHORITY=http://localhost:8080/local/cognito
AUTHENTICATION__STS__AUTHORITY=http://localhost:8080/local/sts
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080
# TracesNT settings are secrets and come straight from .env, using the configuration binding path
# (TRACESNT__CREDENTIALS__CUSTOMS__USERNAME and friends) so there is only one name per setting.

# AWS resources come from floci (see compose/scripts/floci/ready.d/10-setup.sh).
USE_FLOCI=true
SNS_ENDPOINT=http://floci:4566
SQS_ENDPOINT=http://floci:4566
S3_ENDPOINT=http://floci:4566

# CHED attachment downloads: SNS FIFO topic -> SQS FIFO queue -> consumer -> cdp-uploader -> S3
ChedAttachments__TopicArn=arn:aws:sns:eu-west-2:000000000000:trade_gateway_ched_attachments_internal.fifo
ChedAttachments__QueueUrl=http://floci:4566/000000000000/trade_gateway_ched_attachments_internal_downloader.fifo
ChedAttachments__S3Bucket=trade-gateway-documents
CdpUploader__BaseUrl=http://cdp-uploader:7337
CdpUploader__CallbackUrl=http://trade-gateway:8080/attachments/scan-results
