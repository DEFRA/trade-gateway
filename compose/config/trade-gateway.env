ASPNETCORE_ENVIRONMENT=Development
AUTHENTICATION__COGNITO__AUTHORITY=http://localhost:8080/local/cognito
AUTHENTICATION__STS__AUTHORITY=http://localhost:8080/local/sts
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080
# TracesNT settings are secrets and come straight from .env, using the configuration binding path
# (TRACESNT__CREDENTIALS__CUSTOMS__USERNAME and friends) so there is only one name per setting.
