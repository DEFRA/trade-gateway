<?xml version="1.0" encoding="utf-8"?>
<!--
We dynamically create a master WSDL that pulls in all endpoints simultaneously.
This FORCES dotnet-svcutil to resolve the entire global object graph in memory at once,
which natively deduplicates the data models.
-->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" targetNamespace="http://tempuri.org/">
  <wsdl:import location="https://webgate.acceptance.ec.europa.eu/tracesnt/ws/EuIntraCertificateServiceV1?wsdl" namespace="http://ec.europa.eu/tracesnt/ws/impl/certificate/euintra/v1" />
  <wsdl:import location="https://webgate.acceptance.ec.europa.eu/tracesnt/ws/ReferenceDataServiceV1?wsdl" namespace="http://ec.europa.eu/tracesnt/ws/impl/referencedata/v1"/>
  <wsdl:import location="https://webgate.acceptance.ec.europa.eu/tracesnt/ws/ChedCertificateServiceV2?wsdl" namespace="http://ec.europa.eu/tracesnt/ws/impl/certificate/ched/v2"/>
  <wsdl:import location="https://webgate.acceptance.ec.europa.eu/tracesnt/ws/CustomsCertexChedServiceV06?wsdl" namespace="http://ec.europa.eu/sanco/tracesnt/customs_certex/base/v06" />
  <wsdl:import location="https://webgate.acceptance.ec.europa.eu/tracesnt/ws/DocomCertificateRetrievalServiceV1?wsdl" namespace="http://ec.europa.eu/tracesnt/ws/impl/certificate/docom/retrieval/v1"/>
</wsdl:definitions>
