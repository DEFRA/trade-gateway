# Points Trade Gateway at the local TRACES NT simulator in DEFRA/trade-tracesnt-stub instead of the
# EU acceptance environment. Nothing here is a real credential — these are the simulator's own
# expected values, and they must match Simulator:Credentials in the stub's appsettings.json.
#
# Use it with:
#   docker compose --env-file .env.simulator up      (or add it to the trade-gateway env_file list)
#   cp .env.simulator .env                           (replaces the acceptance credentials)
#
# The simulator hosts all five service paths under one base URL, so this is the only switch needed.
# It listens on 8085; use http://host.docker.internal:8085 if the gateway runs in compose and the
# simulator on the host.
TRACESNT__BASEURL=http://localhost:8085

# Required, or the gateway fails validation at start-up. Same casing as .env, so if compose loads
# both files the later one wins rather than two keys competing for one setting.
TracesNt__CustomsOfficeReferenceNumber=GBTEST01

# The default TracesNT account, used by the CHED, EU-INTRA and reference-data ports
TRACESNT__CREDENTIALS__DEFAULT__USERNAME=simulator-user
TRACESNT__CREDENTIALS__DEFAULT__AUTHENTICATIONKEY=simulator-auth-key
TRACESNT__CREDENTIALS__DEFAULT__WEBSERVICECLIENTID=simulator-client-id

# The customs account, used by the quantity-management port. The simulator rejects these on any
# other port, and rejects the default account on the customs port, so they cannot be swapped.
TRACESNT__CREDENTIALS__CUSTOMS__USERNAME=simulator-customs-user
TRACESNT__CREDENTIALS__CUSTOMS__AUTHENTICATIONKEY=simulator-customs-auth-key
TRACESNT__CREDENTIALS__CUSTOMS__WEBSERVICECLIENTID=simulator-customs-client-id
