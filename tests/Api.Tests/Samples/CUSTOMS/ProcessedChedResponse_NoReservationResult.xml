  <S:Body>
    <ProcessedChedInformationResponse xmlns="http://ec.europa.eu/sanco/tracesnt/customs_certex/ched/v06">
      <ChedCertificate>
        <SPSCertificate xmlns="urn:un:unece:uncefact:data:standard:SPSCertificate:17">
          <SPSExchangedDocument>
            <ID xmlns="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:21"
              >CHEDA.GB.2026.0000123</ID
            >
          </SPSExchangedDocument>
        </SPSCertificate>
      </ChedCertificate>
      <OperationCode>1</OperationCode>
      <PushActive>false</PushActive>
    </ProcessedChedInformationResponse>
  </S:Body>
</S:Envelope>
